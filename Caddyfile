# family-pie.ru — production Caddy config (deployed 2026-06-22).
# =============================================================================
# Static studio landing + central public legal host, ADDITIVE to the existing
# VPS (103.246.144.198, NL; Caddy v2.11.4). The previous /etc/caddy/Caddyfile is
# backed up on the server (Caddyfile.bak.<ts>) before each change.
#
#   - food-proxy port = 8787 (healthroutine-food.service, node) — unchanged
#   - studio web-root = /var/www/family-pie/site (this repo's site/)
#   - apex /            -> studio landing (was a 200 text fallback)
#   - /<app>/legal|terms|privacy -> built legal pages under site/<app>/
#   - apex /privacy /terms -> back-compat alias to the new health_routine pages
# =============================================================================

# HealthRoutine food proxy — separate service (node, systemd). Unchanged.
food.family-pie.ru {
	reverse_proxy 127.0.0.1:8787
	encode gzip
}

family-pie.ru {
	encode zstd gzip
	root * /var/www/family-pie/site

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Back-compat: the HealthRoutine app historically linked the apex /privacy and
	# /terms. Serve the new health_routine pages at those URLs so existing in-app
	# links keep working. Drop this once HR links point at /health_routine/{privacy,terms}.
	@hr_privacy path /privacy
	handle @hr_privacy {
		rewrite * /health_routine/privacy.html
		file_server
	}
	@hr_terms path /terms
	handle @hr_terms {
		rewrite * /health_routine/terms.html
		file_server
	}

	# Clean URLs: /<app>/legal|terms|privacy -> <app>/<doc>.html ; apex -> landing.
	handle {
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}
}
