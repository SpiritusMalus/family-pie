# family-pie.ru — production Caddy config.
# =============================================================================
# ⚠️ THIS FILE IS INSTALLED ONTO THE SERVER by .github/workflows/deploy.yml.
# It must therefore describe production EXACTLY — every host, including the ones
# this repository knows nothing about.
#
# It did not, between 2026-06-22 and 2026-08-13. The site deploy had been broken
# since June (see the deploy workflow), so nobody noticed that /etc/caddy grew a
# global options block and a whole extra host while this file stood still.
# Shipping the old copy would have dropped relo.family-pie.ru and put Caddy back
# on :443 — where it is not supposed to be — taking every site down. Reconstructed
# from the live config on 2026-08-13.
#
# BEFORE EDITING: diff against production, because the wrapper installs whatever
# is here.
#     ssh <box> "cat /etc/caddy/Caddyfile" > /tmp/live && diff /tmp/live Caddyfile
# =============================================================================

{
	admin off
	# Caddy is NOT the edge here: something else owns :443 and forwards inward,
	# so TLS is terminated on 9443 and Caddy must not invent its own redirects.
	# Removing these three lines makes Caddy grab :443, collide, and take the box
	# offline — this is the single most dangerous block in the file.
	http_port 80
	https_port 9443
	auto_https disable_redirects
}

# Studio landing + the central public legal host (built from content/ by
# tools/build-legal.mjs into site/).
family-pie.ru {
	encode zstd gzip
	root * /var/www/family-pie/site

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"

		# The purchase page lives on this host, so a missing frame guard is not
		# theoretical: framed by someone else's page, its buttons can be clicked
		# through. `frame-ancestors 'none'` is the modern control and X-Frame-Options
		# the fallback for anything that predates it — both, because the cost is two
		# lines and the failure is silent.
		#
		# The CSP fits what these pages actually are: static HTML with inline <style>
		# and inline checkout scripts (Driftora and Sufler call their APIs), so
		# 'unsafe-inline' is required for style-src and script-src until those move to
		# files. connect-src names the API host that script calls; everything else is
		# denied by the default-src 'self' floor. No frames, no objects, no <base>
		# takeover, and forms cannot post anywhere (these pages carry no <form>).
		#
		# fonts.googleapis.com / fonts.gstatic.com are NOT optional decoration: every
		# page here <link>s the Space Grotesk / Space Mono / Manrope stylesheet, and a
		# CSP without them serves the whole site in fallback type. The stylesheet is a
		# style-src; the font files it then pulls are a font-src — both are needed, and
		# omitting either breaks it silently in the browser rather than loudly here.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://food.family-pie.ru; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

		# Pages must be revalidated, never served from cache on faith. Without an
		# explicit Cache-Control a browser invents one from Last-Modified (the usual
		# heuristic is ~10% of the document's age), so a page stable for weeks gets
		# cached for days — and a deploy becomes invisible to exactly the people who
		# have been here before, while nothing in the logs looks wrong. It cost us a
		# "where is the button?" about a button that had been live for twenty minutes.
		# `no-cache` still STORES the copy; the ETag turns the check into a bodiless
		# 304.
		#
		# Applied to EVERYTHING here, not just *.html, and that is deliberate: the
		# site serves clean URLs (/driftora/subscription, /driftora/terms) that are
		# rewritten to .html only AFTER matching, so a `path *.html` matcher covers
		# the landing and misses every page that matters. Nothing on this host is
		# content-hashed, so there is nothing that wants a long cache anyway.
		Cache-Control "no-cache"
	}

	# Temporary provider compatibility only. The owner cannot access YooKassa
	# yet; retire this after its notification URL is verified on family-spy.ru.
	handle /vpn/api/billing/webhook {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy 127.0.0.1:8796
	}
	@retired_vpn_api path /vpn/api /vpn/api/*
	handle @retired_vpn_api {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		respond "Use https://family-spy.ru/vpn/" 410
	}
	# An old installed worker must receive a same-origin retirement script.
	# Redirecting the script itself would leave the previous cached worker active.
	handle /vpn/sw.js {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /retire-customer-worker.js
		file_server
	}
	@retired_product_pages path /vpn /vpn/* /sufler /sufler/*
	handle @retired_product_pages {
		redir https://family-spy.ru{uri} permanent
	}

	# Rebrand HealthRoutine→Driftora: the legal host path moved
	# /health_routine/* -> /driftora/*. Permanent (301), path- and query-preserving
	# so every old deep link keeps resolving. The inner `route` keeps directive
	# order (rewrite-before-redir); `uri replace` swaps just the prefix so the new
	# path lands in {uri} carrying the query, and `redir {uri}` is placeholder-led
	# so Caddy does not read the target as a path matcher.
	@hr_legacy path /health_routine/*
	handle @hr_legacy {
		route {
			uri replace /health_routine /driftora 1
			redir {uri} permanent
		}
	}

	# Back-compat: the HealthRoutine app historically linked the apex /privacy and
	# /terms. Serve the driftora pages there so existing in-app links keep working.
	@hr_privacy path /privacy
	handle @hr_privacy {
		rewrite * /driftora/privacy.html
		file_server
	}
	@hr_terms path /terms
	handle @hr_terms {
		rewrite * /driftora/terms.html
		file_server
	}

	# Clean URLs: /<app>/legal|terms|privacy -> <app>/<doc>.html, and a directory
	# such as /driftora/subscription/ -> its index.html. Apex falls back to the
	# landing.
	handle {
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}
}

# Driftora food-parse service (node, systemd: healthroutine-food.service).
# Also serves /billing/* — payments, licence keys and the app's return page.
food.family-pie.ru {
	# NOTE: production has never carried the /test-billing/* route that used to
	# stand here — it was removed from the live config once the real shop was
	# verified, but survived in this file. Deploying it back would republish the
	# TEST-shop instance on :8799 (payments that take no money) on a live host.
	# It is deleted rather than commented out so it cannot be revived by accident.

	# The API answers a native app, not a browser: nothing here should ever be
	# framed, sniffed, or reached as a document. `-Server`/`-X-Powered-By` stop
	# the stack from naming itself and its version to a scanner.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
		-X-Powered-By
	}

	reverse_proxy 127.0.0.1:8787
	encode gzip
}

# Relo Dojo backend. NOT built from this repository — it is here because this
# file is the whole server config, and omitting it deletes the host.
relo.family-pie.ru {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
	reverse_proxy 127.0.0.1:8010
}

# ---------------------------------------------------------------------------
# grammardojo.ru — демо-стенд сайта кадастрового инженера (боевой: mkadastr.ru).
# Стоит в этом файле по той же причине, что и relo.family-pie.ru: ЭТОТ ФАЙЛ —
# ВЕСЬ КОНФИГ СЕРВЕРА, и хост, которого здесь нет, при следующем деплое исчезает.
#
# Домен обязан стоять ещё и в SNI-карте /etc/nginx/nginx.conf: без неё :443
# уводит это имя в xray, и сайт не открывается вообще.
# Сертификат берётся через tls-alpn-01 — то есть через тот же :443 и ту же
# карту. Порт 80 здесь занят acme.sh под sub.family-pie.ru и не трогается.
# ---------------------------------------------------------------------------
grammardojo.ru, www.grammardojo.ru {
	encode zstd gzip
	root * /var/www/grammardojo

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

		# Демо в поиск не пускаем: боевой сайт живёт на другом домене, и две
		# одинаковые копии в индексе бьют по нему же. Дублирует <meta robots>
		# в разметке — заголовок действует и на то, что метатега не имеет.
		X-Robots-Tag "noindex, nofollow"

		# Ни одна страница и ни один файл стилей здесь не содержит хеша в
		# имени, поэтому браузер обязан каждый раз переспрашивать, не
		# изменились ли они. Без Cache-Control он придумывает срок годности
		# сам — обычная эвристика около 10% от возраста файла — и после
		# выкатки человек продолжает видеть старую вёрстку, причём в логах
		# сервера всё выглядит нормально: запросов просто нет.
		#
		# `no-cache` не запрещает хранить копию — он требует переспросить.
		# Вместе с ETag ответ превращается в пустой 304, трафик почти не растёт.
		Cache-Control "no-cache"

		# script-src без 'unsafe-inline': на страницах нет ни одного инлайнового
		# <script>, весь код в js/main.js. А вот style-src с 'unsafe-inline'
		# обязателен — в разметке 92 инлайновых style=, снятых с макета.
		# frame-src нужен под виджет Яндекс.Карт в секции контактов; без него
		# карта молча остаётся белым прямоугольником.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://yandex.ru https://*.yandex.ru https://yandex.com https://*.yandex.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Приём заявок. Сервис слушает только петлю (127.0.0.1:8791), наружу он
	# виден исключительно по этому пути и ничем больше.
	handle /api/zayavka* {
		reverse_proxy 127.0.0.1:8791
	}

	handle {
		try_files {path} {path}/ {path}.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Complete customer site with same-origin VPN, Sufler billing and native APIs.
www.family-spy.ru {
	redir https://family-spy.ru{uri} permanent
}

family-spy.ru {
	encode zstd gzip
	root * /var/www/family-products/site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
		Cache-Control "no-cache"
	}
	# Public native packages are outside the deploy artifact's rsync --delete root.
	@sufler_download path /sufler/download/Sufler-Setup-0.2.0-x64.exe /sufler/download/Sufler-0.2.0-x64-portable.exe /sufler/download/Sufler-0.2.0-arm64.dmg /sufler/download/Sufler-0.2.0-x64.dmg /sufler/download/SHA256SUMS.txt /sufler/download/release.json
	handle @sufler_download {
		root * /var/www/sufler-downloads/current
		uri strip_prefix /sufler/download
		file_server
	}
	handle /vpn/api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8796
	}
	@sufler_customer_api path /sufler/api/billing/plan /sufler/api/billing/checkout /sufler/api/billing/result
	handle @sufler_customer_api {
		uri strip_prefix /sufler/api
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8776 {
			header_up -Cookie
			header_up -Authorization
		}
	}
	# Native clients send device/lease headers, never the owner's provider key.
	# Keep an exact route allowlist; stream answers as the backend emits them.
	@sufler_native_api path /sufler/api/health /sufler/api/v1/managed-status /sufler/api/v1/status /sufler/api/v1/start /sufler/api/v1/beat /sufler/api/v1/stop /sufler/api/v1/activate /sufler/api/v1/chat/completions
	handle @sufler_native_api {
		uri strip_prefix /sufler/api
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy 127.0.0.1:8776 {
			# text/event-stream flushes immediately with the default transport,
			# while normal cancellation still reaches the upstream.
			header_up -Cookie
			header_up -Authorization
		}
	}
	# Fixed read-only public price endpoints. Never forward visitor credentials.
	@vpn_public_plan {
		method GET HEAD
		path /public-plans/vpn
	}
	handle @vpn_public_plan {
		rewrite * /vpn/api/plans
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8796 {
			method GET
			header_up -Cookie
			header_up -Authorization
			header_up -Origin
		}
	}
	@sufler_public_plan {
		method GET HEAD
		path /public-plans/sufler
	}
	handle @sufler_public_plan {
		rewrite * /billing/plan
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8776 {
			method GET
			header_up -Cookie
			header_up -Authorization
			header_up -Origin
		}
	}
	@build_metadata path /.customer-build
	handle @build_metadata {
		respond 404
	}
	handle {
		try_files {path} {path}/ {path}.html
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Subscription delivery uses the same private identities and upstream.
# Existing TLS at the loopback upstream is verified with its current certificate;
# old installed subscription links keep using their compatibility route.
sub.family-spy.ru {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
	@subscription path /sub/*
	handle @subscription {
		reverse_proxy https://127.0.0.1:2097 {
			header_up -Cookie
			header_up -Authorization
			transport http {
				tls_server_name sub.family-pie.ru
			}
		}
	}
	handle {
		respond 404
	}
}

# Host-owned sites survive application deploys.
import /etc/caddy/local-sites/*.caddy
