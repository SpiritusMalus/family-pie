#
# Resolved [CONFIRM] markers (were unknown in the draft):
#   - internal food-proxy port  = 8787  (node, healthroutine-food.service)
#   - live web-root             = /var/www/legal   (serves HR legal.html today)
#   - studio web-root (new)     = /var/www/family-pie/site   (deploy target for
#     this repo's site/; additive — created alongside, /var/www/legal stays up
#     until step 8e retires the old HR-legal source)
#
# Live today on this VPS (verified 2026-06-22):
#   - food.family-pie.ru                  -> reverse_proxy 127.0.0.1:8787 (gzip)
#   - family-pie.ru/health_routine/legal  -> /var/www/legal/health_routine/legal.html
#   - family-pie.ru/privacy /terms        -> rewrite to HR legal.html (single-project alias)
#   - family-pie.ru/ (apex fallback)      -> respond "family-pie.ru" 200
#   - /relo_dojo/* route                  -> reserved, not yet serving
# Intended change vs live: apex / now serves the studio landing (site/index.html)
# instead of the 200 text fallback; legal folds into site/<repo>/.
# =============================================================================

family-pie.ru {
	encode zstd gzip
	root * /var/www/family-pie/site

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Per-product legal lives under repo-name paths, built into site/<repo>/.
	# Deep-links /privacy /terms inside each product page are relative to the
	# product folder; the legacy apex /privacy /terms aliases (HR-only) are
	# dropped once HR's in-app links point at /health_routine/privacy|terms.
	try_files {path} {path}/ {path}.html /index.html
	file_server
}

# www -> apex (optional; confirm a www A/CNAME record exists before enabling)
www.family-pie.ru {
	redir https://family-pie.ru{uri} permanent
}

# HealthRoutine food proxy — separate service (healthroutine-food.service, node).
# Owned by HealthRoutine; documented here for the full routing picture.
food.family-pie.ru {
	reverse_proxy 127.0.0.1:8787
	encode gzip
}

