# Required future configuration; no merchant or tariffs enabled by default.
VPN_SHOP_ID=
VPN_SHOP_SECRET=
VPN_PAYMENT_TEST_MODE=true
VPN_SMTP_HOST=
VPN_SMTP_USER=
VPN_SMTP_PASSWORD=
VPN_GOOGLE_CLIENT_ID=
VPN_GOOGLE_CLIENT_SECRET=
VPN_PUBLIC_ORIGIN=https://family-spy.ru
# Customer APIs accept the Family Spy origin. Add other origins only explicitly.
VPN_ADDITIONAL_ORIGINS=
# Enable only after DNS, public TLS and subscription parity checks pass.
VPN_SUBSCRIPTION_ORIGIN=https://sub.family-spy.ru
VPN_APPROVED_PLANS_JSON=[]
# Use a NEW private service DB, never the live panel DB.
VPN_DATABASE_PATH=

# Downloaded Web OAuth client JSON, protected outside the repo. Optional alternative to inline variables.
VPN_GOOGLE_CONFIG_FILE=
