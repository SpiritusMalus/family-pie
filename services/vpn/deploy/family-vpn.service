[Unit]
Description=Family VPN authenticated cabinet
After=network.target
[Service]
User=family-vpn
Group=family-vpn
WorkingDirectory=/opt/family-vpn/current/services/vpn
EnvironmentFile=/etc/family-vpn/service.env
ExecStart=/opt/family-vpn/node/bin/node /opt/family-vpn/current/services/vpn/server.mjs
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/family-vpn
MemoryMax=256M
CPUQuota=50%
[Install]
WantedBy=multi-user.target
